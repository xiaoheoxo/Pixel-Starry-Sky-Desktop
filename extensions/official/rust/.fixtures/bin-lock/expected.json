[
  {
    "template": "cargo-clippy",
    "file": "Cargo.lock",
    "tasks": [
      {
        "name": "clippy",
        "description": "运行 clippy 静态检查",
        "linux": "cargo clippy",
        "windows": "cargo clippy"
      }
    ]
  },
  {
    "template": "cargo-doc",
    "file": "Cargo.lock",
    "tasks": [
      {
        "name": "doc",
        "description": "生成本项目的文档（不含依赖）",
        "linux": "cargo doc --no-deps",
        "windows": "cargo doc --no-deps"
      }
    ]
  },
  {
    "template": "cargo-clippy-strict",
    "file": "Cargo.lock",
    "tasks": [
      {
        "name": "clippy-strict",
        "description": "clippy 检查全部目标，警告当作错误",
        "linux": "cargo clippy --all-targets -- -D warnings",
        "windows": "cargo clippy --all-targets -- -D warnings"
      }
    ]
  },
  {
    "template": "cargo-fmt",
    "file": "Cargo.lock",
    "tasks": [
      {
        "name": "fmt",
        "description": "格式化整个工作区",
        "linux": "cargo fmt --all",
        "windows": "cargo fmt --all"
      }
    ]
  },
  {
    "template": "cargo-fmt-check",
    "file": "Cargo.lock",
    "tasks": [
      {
        "name": "fmt-check",
        "description": "只检查格式，不改文件",
        "linux": "cargo fmt --all --check",
        "windows": "cargo fmt --all --check"
      }
    ]
  }
]
