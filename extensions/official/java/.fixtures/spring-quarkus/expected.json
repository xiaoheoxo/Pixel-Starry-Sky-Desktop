  },
  {
    "template": "maven",
    "file": "lib/pom.xml",
    "tasks": [
      {
        "name": "clean",
        "description": "清理 target 目录",
        "linux": "cd lib && mvn clean",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn clean }"
      },
      {
        "name": "compile",
        "description": "编译主代码",
        "linux": "cd lib && mvn compile",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn compile }"
      },
      {
        "name": "test",
        "description": "运行单元测试",
        "linux": "cd lib && mvn test",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn test }"
      },
      {
        "name": "package",
        "description": "打包（jar / war）",
        "linux": "cd lib && mvn package",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn package }"
      },
      {
        "name": "verify",
        "description": "运行测试和集成检查",
        "linux": "cd lib && mvn verify",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn verify }"
      },
      {
        "name": "install",
        "description": "打包并安装到本地仓库",
        "linux": "cd lib && mvn install",
        "windows": "Set-Location -LiteralPath lib; if ($?) { mvn install }"
      }
    ]
  },
