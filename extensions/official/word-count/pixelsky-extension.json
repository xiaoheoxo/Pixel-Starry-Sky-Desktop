{
  "id": "pixelsky.word-count",
  "name": "字数统计",
  "version": "1.0.0",
  "publisher": "pixelsky",
  "description": "统计选中内容或整个文件的字数、词数和行数",
  "icon": "icon.png",
  "keywords": ["word count", "字数"],
  "license": "MIT",
  "repository": "https://github.com/xiaoheoxo/Pixel-Starry-Sky-Desktop",
  "homepage": null,
  "engines": {
    "pixelsky": ">=0.7.1"
  },
  "l10n": {
    "en": {
      "name": "Word Count",
      "description": "Counts characters, words and lines in the selection or the whole file"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "count",
        "title": {
          "zh": "统计字数",
          "en": "Count words"
        },
        "where": ["palette", "editor"],
        "requires": "editor"
      }
    ]
  },
  "main": "main.js",
  "permissions": ["editor.read", "ui.notify"],
  "price": null
}
