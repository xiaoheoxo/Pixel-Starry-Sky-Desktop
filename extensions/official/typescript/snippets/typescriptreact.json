  },
  "引用 useRef": {
    "prefix": "ur",
    "body": ["const ${1:ref} = useRef<${2:HTMLDivElement}>(null);"],
    "description": "useRef 引用 hook"
  },
  "Context + Provider + hook": {
    "prefix": "ctx",
    "body": [
      "import { createContext, useContext, useState, type ReactNode } from 'react';",
      "",
      "interface ${1:App}ContextValue {",
      "  ${2:value}: string;",
      "  set${3:Value}: (next: string) => void;",
      "}",
      "",
      "const ${1:App}Context = createContext<${1:App}ContextValue | null>(null);",
      "",
      "export function ${1:App}Provider({ children }: { children: ReactNode }) {",
      "  const [${2:value}, set${3:Value}] = useState('');",
      "  return (",
      "    <${1:App}Context.Provider value={{ ${2:value}, set${3:Value} }}>",
      "      {children}",
      "    </${1:App}Context.Provider>",
      "  );",
      "}",
      "",
      "export function use${1:App}(): ${1:App}ContextValue {",
      "  const ctx = useContext(${1:App}Context);",
      "  if (!ctx) throw new Error('use${1:App} must be used inside ${1:App}Provider');",
      "  return ctx;",
      "}",
      "$0"
    ],
    "description": "创建 Context、Provider 和使用它的 hook"
  },
  "自定义 hook": {
    "prefix": "uhook",
    "body": [
      "export function use${1:Thing}(${2:arg}: ${3:string}) {",
      "  const [${4:state}, set${5:State}] = useState<${6:string | null}>(null);",
      "",
      "  useEffect(() => {",
      "    $0",
      "  }, [${2:arg}]);",
      "",
      "  return ${4:state};",
      "}"
    ],
    "description": "自定义 hook"
  }
