{
  "comment": "版本号比较的共享用例：协议包的 compareExtVersion 读它；来源是云端 services/cloud/internal/extensions/semver_test.go，另加几条边界（相等、uint64 溢出、两个都不合法）。云端以后也可以读这个文件",
  "order": [
    "1.0.0-alpha",
    "1.0.0-alpha.1",
    "1.0.0-alpha.beta",
    "1.0.0-beta",
    "1.0.0-beta.2",
    "1.0.0-beta.11",
    "1.0.0-rc.1",
    "1.0.0",
    "1.0.1",
    "1.1.0",
    "1.10.0",
    "2.0.0",
    "10.0.0"
  ],
  "valid": ["0.0.0", "1.2.3", "1.0.0-beta.1", "1.0.0-x-y.0"],
  "invalid": ["", "1.0", "v1.0.0", "01.0.0", "1.0.0+build", "1.0.0-", "1.0.0-a..b", "1.0.0.0"],
  "pairs": [
    { "a": "1.0.0", "b": "1.0.0", "result": 0 },
    { "a": "1.0.0-rc.1", "b": "1.0.0-rc.1", "result": 0 },
    { "a": "1.0.0-01", "b": "1.0.0-1", "result": 0, "note": "纯数字段按数值比，前导 0 不影响" },
    { "a": "1.0.0-1", "b": "1.0.0-a", "result": -1, "note": "纯数字段比非数字段小" },
    { "a": "1.0.0-Beta", "b": "1.0.0-beta", "result": -1, "note": "非数字段按 ASCII，大写在前" },
    { "a": "bad", "b": "0.0.1", "result": -1, "note": "不合法的排在最前面" },
    { "a": "0.0.1", "b": "bad", "result": 1 },
    { "a": "bad", "b": "worse", "result": -1, "note": "两个都不合法：按字符串比" },
    { "a": "worse", "b": "bad", "result": 1 },
    { "a": "bad", "b": "bad", "result": 0 },
    { "a": "18446744073709551615.0.0", "b": "1.0.0", "result": 1, "note": "uint64 最大值还合法" },
    { "a": "18446744073709551616.0.0", "b": "1.0.0", "result": -1, "note": "超过 uint64：云端解析失败，当作不合法" },
    {
      "a": "1.0.0-18446744073709551616",
      "b": "1.0.0-18446744073709551615",
      "result": 1,
      "note": "超过 uint64 的预发布段当作非数字段：非数字比数字大"
    }
  ]
}
