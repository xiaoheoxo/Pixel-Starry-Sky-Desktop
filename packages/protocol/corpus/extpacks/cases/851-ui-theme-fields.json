{
  "title": "界面主题的 id 写法不对",
  "expectCodes": ["uiTheme.fields"],
  "input": "folder",
  "base": "pixelsky.dotenv",
  "appVersion": "0.7.5",
  "remove": ["syntaxes", "snippets", "language-configuration.json", "samples"],
  "files": {
    "pixelsky-extension.json": {
      "merge": {
        "engines": {
          "pixelsky": ">=0.7.5"
        },
        "contributes": {
          "grammars": null,
          "snippets": null,
          "uiThemes": [
            {
              "id": "Bad Id",
              "label": {
                "zh": "毛玻璃",
                "en": "Glass"
              },
              "path": "themes/glass.json"
            }
          ]
        }
      }
    },
    "themes/glass.json": {
      "json": {
        "pixelskyTheme": 1,
        "base": "default",
        "dark": {
          "text": "#e8ecf8"
        },
        "glass": {
          "transparency": {
            "dark": 65,
            "light": 50
          },
          "blur": 14,
          "saturate": 170,
          "brightness": {
            "dark": 62,
            "light": 120
          },
          "grain": 0,
          "rim": 45
        }
      }
    }
  }
}
