{
  "title": "颜色不是 #RRGGBB，还带了不认识的变量",
  "expectCodes": ["uiTheme.file"],
  "input": "folder",
  "base": "pixelsky.dotenv",
  "appVersion": "0.7.5",
  "remove": ["syntaxes", "snippets", "language-configuration.json", "samples"],
  "files": {
    "pixelsky-extension.json": {
      "merge": {
        "engines": {
          "pixelsky": ">=0.7.5"
        },
        "contributes": {
          "grammars": null,
          "snippets": null,
          "uiThemes": [
            {
              "id": "glass",
              "label": {
                "zh": "毛玻璃",
                "en": "Glass"
              },
              "path": "themes/glass.json"
            }
          ]
        }
      }
    },
    "themes/glass.json": {
      "json": {
        "pixelskyTheme": 1,
        "dark": {
          "text": "red",
          "--x": "#000000"
        }
      }
    }
  }
}
