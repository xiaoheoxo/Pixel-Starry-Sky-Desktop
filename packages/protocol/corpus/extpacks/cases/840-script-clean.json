{
  "title": "带脚本的命令：合格",
  "expectCodes": [],
  "input": "folder",
  "base": "pixelsky.dotenv",
  "appVersion": "0.7.1",
  "remove": ["syntaxes", "snippets", "language-configuration.json", "samples"],
  "files": {
    "dist/main.js": "pixelsky.commands.register('formatJson', async () => {\n  const context = await pixelsky.editor.getContext()\n  return context.selection.text\n})\n",
    "pixelsky-extension.json": {
      "merge": {
        "engines": {
          "pixelsky": ">=0.7.1"
        },
        "main": "dist/main.js",
        "permissions": ["editor.read", "editor.write"],
        "contributes": {
          "grammars": null,
          "snippets": null,
          "commands": [
            {
              "id": "formatJson",
              "title": {
                "zh": "排版 JSON",
                "en": "Format JSON"
              },
              "where": ["palette", "editor"],
              "requires": "selection",
              "keybinding": {
                "code": "KeyJ",
                "mod": true,
                "alt": true
              }
            }
          ]
        }
      }
    }
  }
}
