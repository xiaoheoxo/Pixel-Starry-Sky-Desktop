# 依赖与构建产物
node_modules/
out/
dist/
release/
target/

# 只在本机的开发资料：规划文档、协作规则、临时文件、云端服务、工作空间配置，不上传
/docs/
/AGENTS.md
/CLAUDE.md
/scratch/
/services/
/.ccpanes/
/scripts/check-docs.mjs
/scripts/clean-scratch.mjs

# 系统与编辑器
.DS_Store
Thumbs.db
*.log
.env
.env.*

# 截图只保留在本机，不入库（D062）
docs/screenshots/

# 本机工具设置
.claude/settings.local.json

# 各包误放的临时目录（应放根目录 scratch/）
packages/*/scratch/
apps/*/scratch/

# 云端服务（services/cloud）构建出的二进制
services/cloud/pixelsky-cloud
services/cloud/*.exe
services/cloud/deploy/*-linux-amd64

# 随包的 rg / fd（packages/cli/scripts/tools.mjs 下载，按 tools.lock.json 校验）
packages/cli/vendor/
