{
  "name": "@pixelsky/desktop",
  "version": "0.5.8",
  "private": true,
  "description": "像素星空桌面端",
  "homepage": "https://github.com/xiaoheoxo/Pixel-Starry-Sky-Desktop",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:demo": "node scripts/dev.mjs --demo",
    "build": "pnpm --filter @pixelsky/cli bundle && electron-vite build && electron-vite build --config electron.remote.config.ts",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "capture": "electron-vite build && node scripts/capture.mjs",
    "capture:demo": "electron-vite build && node scripts/capture.mjs --demo",
    "dist": "pnpm build && electron-builder --win --publish never",
    "dist:mac": "pnpm build && electron-builder --mac --publish never",
    "dist:linux": "pnpm build && electron-builder --linux --publish never",
    "test": "vitest run src/renderer/src src/main src/shared src/workers --root ."
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pixelsky/engine": "workspace:*",
    "@pixelsky/extension-cli": "workspace:*",
    "@pixelsky/link": "workspace:*",
    "@pixelsky/protocol": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "katex": "^0.19.0",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2",
    "yaml": "^2.9.1"
  },
  "author": "xiao_hei",
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^5.5.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^5.7.284",
    "ssh2": "^1.17.0",
    "uqr": "^0.1.3"
  }
}
