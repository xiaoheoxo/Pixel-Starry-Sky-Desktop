+        // （packages/cli/src/extensions/mcp.ts）。停用不写 mcp.json；登录把授权链接交给桌面端在浏览器里打开，
+        // 本机回调端口照常等着，登录完 signIn 自己重新连接，状态跟着推回去
+        const pixelskyStatus = () => servers.map((server) => ({
